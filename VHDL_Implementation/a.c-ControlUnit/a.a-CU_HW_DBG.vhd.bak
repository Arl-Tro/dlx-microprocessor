library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;
use ieee.std_logic_arith.all;
use work.myTypes.all;
use work.cpu_32b_types.all;
--use ieee.numeric_std.all;
--use work.all;

entity dlx_cu is
  generic (
    MICROCODE_MEM_SIZE : integer := 64; -- Microcode Memory Size
    FUNC_SIZE : integer := 11; -- Func Field Size for R-Type Ops
    OP_CODE_SIZE : integer := 6; -- Op Code Size
    -- ALU_OPC_SIZE       :     integer := 6;  -- ALU Op Code Word Size
    IR_SIZE : integer := 32; -- Instruction Register Size    
    CW_SIZE : integer := 17); -- Control Word Size (UNUSED)
  port (
    Clk : in std_logic; -- Clock
    Rst : in std_logic; -- Reset:Active-Low
    -- Instruction Register
    IR_IN : in std_logic_vector(IR_SIZE - 1 downto 0);
    BRANCH : in std_logic; -- Branch signal, if 1 the branch should be taken
    STALL : in std_logic; -- Stall signal generated by the hazard unit, required to reset control words

    -- Fetch stage interface
    FETCH_CTRL : out if_ctrl_in_t;
    -- Decode stage outerface
    DECODE_CTRL : out id_ctrl_in_t;
    -- Execute stage interface
    EXECUTE_CTRL : out ex_ctrl_in_t;
    -- Memory stage interface
    MEMORY_CTRL : out mem_ctrl_in_t;
    -- Writeback stage interface
    WRITEBACK_CTRL : out wb_ctrl_in_t
  ); -- Register File Write Enable

end dlx_cu;

architecture dlx_cu_hw of dlx_cu is

  constant CW_SIZE_CU : natural := 22;

  type mem_array is array (integer range 0 to MICROCODE_MEM_SIZE - 1) of std_logic_vector(CW_SIZE_CU - 1 downto 0);
  type pipe_stage is (X, FETCH, DECODE, EXECUTE, MEMORY, WRITEBACK);

  -- Control-word bit order (MSB -> LSB):
  -- F  EN_IR, EN_NPC
  -- D  EN_RS1, EN_RS2, EN_RIMM, SHORT_LONG_IMMEDIATE, LINK_EN, IS_RR_OP, SIGN_IMMEDIATE
  -- E  MUX_A_SEL, MUX_B_SEL, EN_RALUOUT, BEQZ (set to branch on 0), BNEQZ (set to branch on != 0)
  -- M  DRAM_WRITE, SIGNED_LOAD, MODE_WORD, MODE_B/HW, EN_LMD, EN_JUMP
  -- W  WB_SEL (If 1, write RAM data, else ALU data), EN_IRF_WRITE (also drives W_EN_IRF)
  signal cw_mem : mem_array := (

    "1111000101010000000001", -- 0x00 : R-type instructions (FUNC field selects the operation)
    "0000000000000000000000", -- 0x01 : Unused / reserved
    "1100110010101100000000", -- 0x02 : j
    "1100111010111100000001", -- 0x03 : jal
    "1110100010101000000000", -- 0x04 : beqz
    "1110100010100100000000", -- 0x05 : bnez
    "0000000000000000000000", -- 0x06 : bfpt / Not Implemented
    "0000000000000000000000", -- 0x07 : bfpf / Not Implemented
    "1110100011110000000001", -- 0x08 : addi
    "1110100001110000000001", -- 0x09 : addui
    "1110100011110000000001", -- 0x0A : subi
    "1110100001110000000001", -- 0x0B : subui
    "1110100011110000000001", -- 0x0C : andi
    "1110100011110000000001", -- 0x0D : ori
    "1110100011110000000001", -- 0x0E : xori
    "0000000000000000000000", -- 0x0F : lhi/ ToDo
    "0000000000000000000000", -- 0x10 : rfe / Return from exception not implemented, as no exception handling was implemented
    "0000000000000000000000", -- 0x11 : trap / Similar to an exception handler call, not implemented
    "1110100001101100000000", -- 0x12 : jr
    "1110101001111100000001", -- 0x13 : jalr
    "1110100011110000000001", -- 0x14 : slli
    "1100000000000000000000", -- 0x15 : nop
    "1110100011110000000001", -- 0x16 : srli
    "1110100011110000000001", -- 0x17 : srai
    "1110100011110000000001", -- 0x18 : seqi
    "1110100011110000000001", -- 0x19 : snei
    "1110100011110000000001", -- 0x1A : slti
    "1110100011110000000001", -- 0x1B : sgti
    "1110100011110000000001", -- 0x1C : slei
    "1110100011110000000001", -- 0x1D : sgei
    "1100000000000000000000", -- 0x1E : CUSTOM / SAVE: decrements CWP by 1, causing CWP-1 to become the new active register window (internally checks for the need to spill to memory)
    "1100000000000000000000", -- 0x1F : CUSTOM / RESTORE: increments CWP by 1, causing CWP+1 to become the new active register window (internally checks for the need to restore from memory)
    "1111100011110001001011", -- 0x20 : lb
    "1111100011110001011011", -- 0x21 : lh
    "1111000101010000000001", -- 0x22 : CUSTOM / Mult
    "1111100011110001101011", -- 0x23 : lw
    "1111100011110000001011", -- 0x24 : lbu
    "1111100011110000011011", -- 0x25 : lhu
    "0000000000000000000000", -- 0x26 : lf / NA
    "0000000000000000000000", -- 0x27 : ld / NA
    "1111100011110010000000", -- 0x28 : sb
    "1111100011110010010000", -- 0x29 : sh
    "0000000000000000000000", -- 0x2A : Unused
    "1111100011110010100000", -- 0x2B : sw
    "0000000000000000000000", -- 0x2C : Unused
    "0000000000000000000000", -- 0x2D : Unused
    "0000000000000000000000", -- 0x2E : sf / NA
    "0000000000000000000000", -- 0x2F : sd / NA
    "0000000000000000000000", -- 0x30 : Unused
    "0000000000000000000000", -- 0x31 : Unused
    "0000000000000000000000", -- 0x32 : Unused
    "0000000000000000000000", -- 0x33 : Unused
    "0000000000000000000000", -- 0x34 : Unused
    "0000000000000000000000", -- 0x35 : Unused
    "0000000000000000000000", -- 0x36 : Unused
    "0000000000000000000000", -- 0x37 : Unused
    "0000000000000000000000", -- 0x38 : itlb / ToDo
    "0000000000000000000000", -- 0x39 : Unused
    "1110100001110000000001", -- 0x3A : sltui
    "1110100001110000000001", -- 0x3B : sgtui
    "1110100001110000000001", -- 0x3C : sleui
    "1110100001110000000001", -- 0x3D : sgeui
    "0000000000000000000000", -- 0x3E : Unused
    "0000000000000000000000" -- 0x3F : Unused
  );
  signal IR_opcode : std_logic_vector(OP_CODE_SIZE - 1 downto 0); -- OpCode part of IR
  signal IR_func : std_logic_vector(FUNC_SIZE - 1 downto 0); -- Func part of IR when Rtype

  -- control word is shifted to the correct stage
  signal cw1 : std_logic_vector(CW_SIZE_CU - 1 downto 0); -- first stage
  signal cw2 : std_logic_vector(CW_SIZE_CU - 1 - 3 downto 0); -- decode-to-execute stage slice
  signal cw3 : std_logic_vector(CW_SIZE_CU - 1 - 7 downto 0); -- execute-to-memory stage slice
  signal cw4 : std_logic_vector(CW_SIZE_CU - 1 - 11 downto 0); -- memory-to-writeback stage slice
  signal cw5 : std_logic_vector(CW_SIZE_CU - 1 - 13 downto 0); -- final writeback stage slice

  -- alu opcode propagation
  signal aluOpcode_i : aluOp := NOP; -- ALUOP defined in package
  signal aluOpcode1 : aluOp := NOP;
  signal aluOpcode2 : aluOp := NOP;
  signal aluOpcode3 : aluOp := NOP;

  -- branch selection
  signal branchBits : std_logic_vector(1 downto 0); -- If Bit(0) is set, branch on zero. If Bit(1) is set, branch on not zero
  signal WAS_BRANCH_LAST : std_logic := '0'; -- Was the last branch taken or not? (if yes, then keep the branch down during the reset cycle)

  signal gated_branch : std_logic; -- Given by evaluating the input BRANCH signal and excluding its behavior if a previous branch was already taken
begin -- dlx_cu_rtl

  IR_opcode(5 downto 0) <= IR_IN(31 downto 26);
  IR_func(FUNC_SIZE - 1 downto 0) <= IR_IN(FUNC_SIZE - 1 downto 0);
  cw1 <= cw_mem(conv_integer(IR_opcode));
  -- The fetch and decode stage's signals can be generated at the same time, thus use only 
  -- a single CW for both
  -- stage one control signals
  FETCH_CTRL.EN_IR <= cw1(CW_SIZE_CU - 1);
  FETCH_CTRL.EN_NPC <= cw1(CW_SIZE_CU - 2);
  -- FETCH_CTRL.EN_PC <= '1';
  -- stage two control signals
  DECODE_CTRL.EN_RS1 <= cw1(CW_SIZE_CU - 3);
  DECODE_CTRL.EN_RS2 <= cw1(CW_SIZE_CU - 4);
  DECODE_CTRL.EN_RIMM <= cw1(CW_SIZE_CU - 5);
  DECODE_CTRL.SHORT_LONG_IMMEDIATE <= cw1(CW_SIZE_CU - 6);
  DECODE_CTRL.LINK_EN <= cw1(CW_SIZE_CU - 7);
  DECODE_CTRL.IS_RR_OP <= cw1(CW_SIZE_CU - 8);
  DECODE_CTRL.IS_STORE <= cw1(CW_SIZE_CU - 15); -- Same as dram WRITE position, if 1 this is  a store
  DECODE_CTRL.SIGN_IMMEDIATE <= cw1(CW_SIZE_CU - 9);
  -- stage three control signals
  DECODE_CTRL.RD_WEN <= cw2(CW_SIZE_CU - 22);
  EXECUTE_CTRL.LINK_EN <= cw2(CW_SIZE_CU - 7);
  EXECUTE_CTRL.MUX_A_SEL <= cw2(CW_SIZE_CU - 10);
  EXECUTE_CTRL.MUX_B_SEL <= cw2(CW_SIZE_CU - 11);
  EXECUTE_CTRL.EN_RALUOUT <= cw2(CW_SIZE_CU - 12);
  EXECUTE_CTRL.IS_LOAD <= cw2(CW_SIZE_CU - 19); -- Take the EN_LMD from CW2, if EN_LMD this means data needs to be loaded from memory, hence this is a LOAD
  branchBits(0) <= cw2(CW_SIZE_CU - 13);
  branchBits(1) <= cw2(CW_SIZE_CU - 14);

  -- stage three alu opcode, should be aluOpcode3 in theory, but due to the 1 CLK delay added by 
  -- aluOpcode1, and the fact that alu_opcode_i is determined in decode stage, this makes sense
  EXECUTE_CTRL.ALU_OP <= aluOpcode1;

  -- stage four control signals
  EXECUTE_CTRL.RD_WEN <= cw3(CW_SIZE_CU - 22);
  MEMORY_CTRL.DRAM_WRITE <= cw3(CW_SIZE_CU - 15);
  MEMORY_CTRL.SIGNED_LOAD <= cw3(CW_SIZE_CU - 16);
  MEMORY_CTRL.MEM_MODE_W <= cw3(CW_SIZE_CU - 17);
  MEMORY_CTRL.MEM_MODE_B_HW <= cw3(CW_SIZE_CU - 18);
  MEMORY_CTRL.EN_LMD <= cw3(CW_SIZE_CU - 19);
  MEMORY_CTRL.EN_JUMP <= cw3(CW_SIZE_CU - 20);

  MEMORY_CTRL.EN_PC <= '1';
  FETCH_CTRL.EN_PC <= '1';

  -- stage five control signals
  MEMORY_CTRL.RD_WEN <= cw4(CW_SIZE_CU - 22);
  WRITEBACK_CTRL.WB_SEL <= cw4(CW_SIZE_CU - 21);

  WRITEBACK_CTRL.RD_WEN <= cw5(CW_SIZE_CU - 22);
  WRITEBACK_CTRL.EN_IRF_WRITE <= cw5(CW_SIZE_CU - 22);
  DECODE_CTRL.W_EN_IRF <= cw5(CW_SIZE_CU - 22); -- TODo remove;
  -- process to pipeline control words
  CW_PIPE : process (Clk, Rst)
  begin -- process Clk
    if Rst = '0' then -- asynchronous reset (active low)
      -- cw1 <= (others => '0');
      -- cw1 <= cw_mem(1); -- Only enable the fetch state in reset, select a NOP
      cw2 <= (others => '0');
      cw3 <= (others => '0');
      cw4 <= (others => '0');
      cw5 <= (others => '0');

      aluOpcode1 <= NOP;
      aluOpcode2 <= NOP;
      aluOpcode3 <= NOP;
    elsif Clk'event and Clk = '1' then -- rising clock edge
      -- cw1 <= cw;
      -- If there is no stall and no Double branch, exec normally
      -- By double branch I mean there are no successive unconditional jumps, because in that situation the second jump is problematic
      -- If not satisfied inject a CW NOP
      if STALL = '0' and gated_branch = '0' then
        cw2 <= cw1(CW_SIZE_CU - 1 - 3 downto 0);
        aluOpcode1 <= aluOpcode_i;
      else
        cw2 <= (others => '0'); -- If the stall signal is high, inject nops in the execute stage (same is done for data in the datapath entity)
        aluOpcode1 <= NOP;
      end if;

      aluOpcode2 <= aluOpcode1;
      aluOpcode3 <= aluOpcode2;

      cw3 <= cw2(CW_SIZE_CU - 1 - 7 downto 0);
      cw4 <= cw3(CW_SIZE_CU - 1 - 11 downto 0);
      cw5 <= cw4(CW_SIZE_CU - 1 - 13 downto 0);

    end if;
  end process CW_PIPE;

  -- purpose: Generation of ALU OpCode
  -- type   : combinational
  -- inputs : IR_i
  -- outputs: aluOpcode
  ALU_OP_CODE_P : process (IR_opcode, IR_func)
  begin -- process ALU_OP_CODE_P
    case conv_integer(unsigned(IR_opcode)) is
        -- case of R type requires analysis of FUNC
      when 0 =>
        case conv_integer(unsigned(IR_func)) is
          when 4 => aluOpcode_i <= SLL_OP; -- sll according to instruction set coding
          when 6 => aluOpcode_i <= SRL_OP; -- srl
          when 7 => aluOpcode_i <= SRA_OP; -- sra
          when 16#20# | 16#21# => aluOpcode_i <= ADD; -- add, addu
          when 16#22# | 16#23# => aluOpcode_i <= SUB; -- sub, subu
          when 16#24# => aluOpcode_i <= AND_OP; -- and
          when 16#25# => aluOpcode_i <= OR_OP; -- or
          when 16#26# => aluOpcode_i <= XOR_OP; -- xor
          when 16#28# => aluOpcode_i <= EQ; -- seq
          when 16#29# => aluOpcode_i <= NE; -- sne
          when 16#2A# => aluOpcode_i <= LT; -- slt
          when 16#2B# => aluOpcode_i <= GT; -- sgt
          when 16#2C# => aluOpcode_i <= LE; -- sle
          when 16#2D# => aluOpcode_i <= GE; -- sge
          when 16#3A# => aluOpcode_i <= LT_U; -- sltu
          when 16#3B# => aluOpcode_i <= GT; -- sgtu (unsigned compare selected by encoder)
          when 16#3C# => aluOpcode_i <= LE; -- sleu (unsigned compare selected by encoder)
          when 16#3D# => aluOpcode_i <= GE; -- sgeu (unsigned compare selected by encoder)
          when 16#3F# => aluOpcode_i <= MULT; -- Custom integer multiply
          when others => aluOpcode_i <= NOP;
        end case;
      when 16#02# => aluOpcode_i <= ADD; -- j, jump relative to PC
      when 16#03# => aluOpcode_i <= ADD; -- jal
      when 16#04# => aluOpcode_i <= ADD; -- bez
      when 16#05# => aluOpcode_i <= ADD; -- bnez
      when 16#08# => aluOpcode_i <= ADD; -- addi
      when 16#0A# => aluOpcode_i <= SUB; -- subi
      when 16#0B# => aluOpcode_i <= SUB; -- subui                     
      when 16#18# => aluOpcode_i <= EQ; -- seqi
      when 16#19# => aluOpcode_i <= NE; -- snei
      when 16#1A# => aluOpcode_i <= LT; -- slti
      when 16#1B# => aluOpcode_i <= GT; -- sgti
      when 16#1C# => aluOpcode_i <= LE; -- slei
      when 16#1D# => aluOpcode_i <= GE; -- sgei
      when 16#14# => aluOpcode_i <= SLL_OP; -- slli
      when 16#16# => aluOpcode_i <= SRL_OP; -- srli
      when 16#17# => aluOpcode_i <= SRA_OP; -- srai
      when 16#12# => aluOpcode_i <= ADD; -- jr
      when 16#13# => aluOpcode_i <= ADD; -- jalr
      when 16#20# => aluOpcode_i <= ADD; -- lb
      when 16#21# => aluOpcode_i <= ADD; -- lh
      when 16#21# => aluOpcode_i <= MULT; -- CUSTOM multiply
      when 16#23# => aluOpcode_i <= ADD; -- lw
      when 16#24# => aluOpcode_i <= ADD; -- lbu
      when 16#25# => aluOpcode_i <= ADD; -- lhu
      when 16#28# => aluOpcode_i <= ADD; -- sb
      when 16#29# => aluOpcode_i <= ADD; -- sh
      when 16#2B# => aluOpcode_i <= ADD; -- sw
      when 16#3A# => aluOpcode_i <= LT_U; -- sltui
      when 16#3B# => aluOpcode_i <= GT; -- sgtui
      when 16#3C# => aluOpcode_i <= LE; -- sleui
      when 16#3D# => aluOpcode_i <= GE; -- sgeui
        -- to be continued and filled with other cases
      when others => aluOpcode_i <= NOP;
    end case;
  end process ALU_OP_CODE_P;

  -- Branch handling
  -- The branch signal may only go high when the branch instruction has reached the execute stage
  -- If the signal goes high -> the branch has executed, the fetch & decode stages should be flushed -> send reset signal
  -- Otherwise there is a predict not taken result taken as valid (the branch is not taken)

  with branchBits select EXECUTE_CTRL.BRANCH_MODE <=
    NO_BRANCH when "00",
    BRANCH_EQZ when "01",
    BRANCH_NEQZ when "10",
    BRANCH_ALL when others;

  -- NOTE: the BRANCH signal is not pipelined, it comes directly from the branch resolution in the exec stage.
  -- It is delayed here so IF/ID can be flushed immediately, while JUMP_SEL is asserted one clock later.
  WAS_BRANCH_LASTAY_P : process (Clk, Rst)
  begin
    if Rst = '0' then
      WAS_BRANCH_LAST <= '0';
    elsif Clk'event and Clk = '1' then
      WAS_BRANCH_LAST <= BRANCH;
    end if;
  end process WAS_BRANCH_LASTAY_P;
  gated_branch <= BRANCH and (not WAS_BRANCH_LAST);
  FETCH_CTRL.NRST_STAGE <= not gated_branch;
  FETCH_CTRL.JUMP_SEL <= gated_branch;
  DECODE_CTRL.NRST_STAGE <= not gated_branch;

  -- stage enable/reset control
  -- FETCH_CTRL.EN_STAGE <= '1';
  -- DECODE_CTRL.EN_STAGE <= '1';
  -- EXECUTE_CTRL.EN_STAGE <= '1';
  EXECUTE_CTRL.NRST_STAGE <= '1';
  -- MEMORY_CTRL.EN_STAGE <= '1';
  MEMORY_CTRL.NRST_STAGE <= '1';
  -- WRITEBACK_CTRL.EN_STAGE <= '1';
  WRITEBACK_CTRL.NRST_STAGE <= '1';
  -- 

end dlx_cu_hw;