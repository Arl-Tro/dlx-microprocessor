library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
use work.myTypes.all;
use work.cpu_32b_types.all;

-- Debug datapath, uses only dbg (behavioral, as easy as possible) entities, implemented mostly to test the control unit behavior

entity DATAPATH_DBG is
    generic (
        NBIT : natural := 32;
        NBIT_IDX : natural := 5 -- Number of bits used to select a signle register, also determines the number of registers

    );

    port (
        -- Global
        CLK : in std_logic;
        NRST : in std_logic; -- Reset, activelow

        -- Fetch stage interface
        FETCH_CTRL : in if_ctrl_in_t;
        -- Decode stage interface
        DECODE_CTRL : in id_ctrl_in_t;
        -- Execute stage interface
        EXECUTE_CTRL : in ex_ctrl_in_t;
        -- Memory stage interface
        MEMORY_CTRL : in mem_ctrl_in_t;
        -- Writeback stage interface
        WRITEBACK_CTRL : in wb_ctrl_in_t;

        -- Top-level observation
        IR_TO_CU : out std_logic_vector(NBIT - 1 downto 0);
        BRANCH : out std_logic; -- Will be 1 if a branch should be taken or 0 otherwise
        STALL : buffer std_logic -- STALL signal as generated by the hazard unit
    );
end entity;

architecture STRUCTURAL of DATAPATH_DBG is

    -- using work.ENTITY does not require declarations 
    -- =========================================================================
    -- Internal Signals for Inter-Stage Connections
    -- =========================================================================

    signal fetch_din : if_data_in_t;
    signal fetch_dout : if_data_out_t;

    signal decode_din : id_data_in_t;
    signal decode_dout : id_data_out_t;
    signal dec_rs1_addr, dec_rs2_addr, dec_rd_addr : std_logic_vector(NBIT_IDX - 1 downto 0); -- Register addresses obtained in the decode stage
    

    signal execute_din : ex_data_in_t; -- Written to by decode stage
    signal execute_din_final : ex_data_in_t; -- What is fed to the execute stage after the NOP/Regular selection by STALL
    signal exec_ctrl_final : ex_ctrl_in_t; -- Same as for din for control signal (after the NOP/Regular)
    signal execute_dout : ex_data_out_t;
    signal alu_out_unbuffered : std_logic_vector(NBIT - 1 downto 0);

    signal memory_din : mem_data_in_t;
    signal memory_dout : mem_data_out_t;

    signal writeback_din : wb_data_in_t;
    signal writeback_dout : wb_data_out_t;

    signal fwd_rs1_data, fwd_rs2_data : std_logic_vector(NBIT - 1 downto 0);
    signal fwd_rs1_en, fwd_rs2_en : std_logic;

    -- Register-file interface between the decode stage and memory system
    signal rf_write : rf_write_port;
    -- signal rf_rs1_addr, rf_rs2_addr : std_logic_vector(NBIT_IDX - 1 downto 0);
    signal rf_rs1_data, rf_rs2_data : std_logic_vector(NBIT - 1 downto 0);

    -- CPU-side data-memory interface between the memory stage and subsystem
    signal cpu_mem_addr : std_logic_vector(NBIT - 1 downto 0);
    signal cpu_data_to_mem : std_logic_vector(NBIT - 1 downto 0);
    signal cpu_data_from_mem : std_logic_vector(NBIT - 1 downto 0);
    signal cpu_read_enable : std_logic;
    signal cpu_write_enable : std_logic_vector(3 downto 0);
    signal spill, fill : std_logic;
    signal mem_sys_reset : std_logic;

    -- Enable signals for each pipeline stage
    signal en_if, en_id, en_exe, en_mem, en_wb : std_logic;
begin

    -- =========================================================================
    -- Top Level Output Assignments
    -- =========================================================================
    IR_TO_CU <= fetch_dout.IR_OUT;
    -- Feed the next stage directly from the previous stage's record output.
    fetch_din.NPC_IN <= execute_dout.NPC_OUT;

    decode_din.IR_IN <= fetch_dout.IR_OUT;
    decode_din.NPC_IN <= fetch_dout.NPC_OUT;

    execute_din.NPC_IN <= decode_dout.NPC_OUT;
    execute_din.RS1_DATA <= decode_dout.RS1_DATA;
    execute_din.RS2_DATA <= decode_dout.RS2_DATA;

    execute_din.RIMM_DATA <= decode_dout.RIMM_DATA;
    execute_din.RD_ADDR_IN <= decode_dout.RD_ADDR_OUT; 

    memory_din.ALU_DATA_IN <= execute_dout.ALU_DATA;
    memory_din.RAM_DATA_IN <= execute_dout.RAM_DATA;
    memory_din.RD_ADDR_IN <= execute_dout.RD_ADDR_OUT;
    BRANCH <= execute_dout.BRANCH;

    writeback_din.ALU_DATA_IN <= memory_dout.ALU_DATA_OUT;
    writeback_din.RAM_DATA_IN <= memory_dout.RAM_DATA_OUT;
    writeback_din.RD_ADDR_IN <= memory_dout.RD_ADDR_OUT;

    mem_sys_reset <= not NRST;

    -- =========================================================================
    -- Component Instantiations
    -- =========================================================================

    -- Forward/Hazard unit 
    CU_HAZARD_inst : entity work.CU_HAZARD
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            IS_RR_OP => DECODE_CTRL.IS_RR_OP,
            RD_ADDR_FET => dec_rd_addr,
            RD_ADDR_DEC => decode_dout.RD_ADDR_OUT,
            RD_ADDR_EX => execute_dout.RD_ADDR_OUT,
            RD_ADDR_MEM => memory_dout.RD_ADDR_OUT,
            RD_ADDR_WB => writeback_dout.RD_ADDR_OUT,
            RS1_ADDR_IF => dec_rs1_addr,
            RS2_ADDR_IF => dec_rs2_addr,
            RD_WEN_DEC => DECODE_CTRL.RD_WEN,
            RD_WEN_EX => EXECUTE_CTRL.RD_WEN,
            RD_WEN_MEM => MEMORY_CTRL.RD_WEN,
            RD_WEN_WB => WRITEBACK_CTRL.RD_WEN,
            IS_LOAD_EX => '0',
            SPILL => '0',
            FILL => '0',
            MEM_RD_REQUEST => MEMORY_CTRL.EN_LMD, -- EN_LMD is what ultimately enables a ram read
            MEM_WR_REQUEST => MEMORY_CTRL.DRAM_WRITE, -- DRAM_WRITE is the signal to write to ram
            MISPREDICT_FLUSH => '0', --ToDo: connect
            ALU_OUT_RESULT => alu_out_unbuffered,
            EX_MEM_RESULT => execute_dout.ALU_DATA,
            MEM_WB_RESULT => writeback_dout.DATA_FORM_MEM,
            WB_RESULT => writeback_dout.RD_DATA_OUT,
            RS1_FWD_DATA => fwd_rs1_data,
            RS2_FWD_DATA => fwd_rs2_data,
            RS1_FWD_EN => fwd_rs1_en,
            RS2_FWD_EN => fwd_rs2_en,
            EN_IF => EN_IF,
            EN_ID => EN_ID,
            EN_EXE => EN_EXE,
            EN_MEM => EN_MEM,
            EN_WB => EN_WB,
            STALL => STALL,
            FLUSH_IF_ID => open,
            FLUSH_ID_EX => open
        );
    -- MEMORY SUBSYSTEM
    MEM_SYS : entity work.data_memory_system
        port map(
            CLK => CLK,
            RESET => mem_sys_reset,
            ENABLE => '1',
            RF_RD1_EN => '1',
            RF_RD2_EN => '1',
            RF_WR_EN => WRITEBACK_CTRL.EN_IRF_WRITE,
            RF_ADD_WR => writeback_dout.RD_ADDR_OUT,
            RF_ADD_RD1 => dec_rs1_addr,
            RF_ADD_RD2 => dec_rs2_addr,
            RF_DATA_IN => writeback_dout.RD_DATA_OUT,
            RF_OUT1 => rf_rs1_data,
            RF_OUT2 => rf_rs2_data,
            CALL => '0',
            RETURN_S => '0',
            CPU_MEM_ADDR => cpu_mem_addr,
            CPU_DATA_TO_MEM => cpu_data_to_mem,
            CPU_DATA_FROM_MEM => cpu_data_from_mem,
            CPU_READ_ENABLE => cpu_read_enable,
            CPU_WRITE_ENABLE => cpu_write_enable,
            SPILL => open,
            FILL => open
        );



    
    -- 1. FETCH STAGE
    FETCH_STAGE_INST : entity work.FETCH_STAGE
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            EN_STAGE => en_if,
            STALL => STALL,
            FETCH_CTRL => FETCH_CTRL,
            FETCH_DIN => fetch_din,
            FETCH_DOUT => fetch_dout
        );

    -- 2. DECODE STAGE
    DECODE_STAGE_inst : entity work.DECODE_STAGE
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            EN_STAGE => en_id,
            DECODE_CTRL => DECODE_CTRL,
            DECODE_DIN => DECODE_DIN,
            DECODE_DOUT => DECODE_DOUT,
            RS1_ADDR => dec_rs1_addr,
            RS2_ADDR => dec_rs2_addr,
            RS1_RF_DATA => rf_rs1_data,
            RS2_RF_DATA => rf_rs2_data,
            RD_ADDR_UNBUFFERED => dec_rd_addr,
            RS1_FWD_DATA => fwd_rs1_data,
            RS2_FWD_DATA => fwd_rs2_data,
            RS1_FWD_EN => fwd_rs1_en,
            RS2_FWD_EN => fwd_rs2_en
        );
    -- NOP insertion before EXECUTE stage
    NOP_EXE_CTRL : process (STALL, EXECUTE_CTRL) begin
        if STALL = '0' then
            exec_ctrl_final <= EXECUTE_CTRL;
        else
            exec_ctrl_final <= EXE_CTRL_ZERO;
        end if;

    end process;
    NOP_EXE_din : process (STALL, execute_din) begin
        if STALL = '0' then
            execute_din_final <= execute_din;
        else
            execute_din_final <= EXE_DIN_ZERO;
        end if;

    end process;

    -- 3. EXECUTE STAGE zdfsdFDFcs
    EXECUTE_STAGE_INST : entity work.EXECUTE_STAGE
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            EN_STAGE => en_exe,
            EXECUTE_CTRL => exec_ctrl_final,
            alu_out => alu_out_unbuffered,
            EXECUTE_DIN => execute_din_final,
            EXECUTE_DOUT => execute_dout
            -- MUX_UNIT_SEL => '0'
        );

    -- 4. MEMORY STAGE
    MEMORY_STAGE_INST : entity work.MEMORY_STAGE
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            EN_STAGE => en_mem,
            MEMORY_CTRL => MEMORY_CTRL,
            MEMORY_DIN => memory_din,
            MEMORY_DOUT => memory_dout,
            CPU_MEM_ADDR => cpu_mem_addr,
            CPU_DATA_TO_MEM => cpu_data_to_mem,
            CPU_DATA_FROM_MEM => cpu_data_from_mem,
            CPU_READ_ENABLE => cpu_read_enable,
            CPU_WRITE_ENABLE => cpu_write_enable
        );

    -- 5. WRITEBACK STAGE
    WRITEBACK_STAGE_INST : entity work.WRITEBACK_STAGE
        generic map(
            NBIT => NBIT,
            NBIT_IDX => NBIT_IDX
        )
        port map(
            CLK => CLK,
            NRST => NRST,
            EN_STAGE => en_wb,
            WRITEBACK_CTRL => WRITEBACK_CTRL,
            WRITEBACK_DIN => writeback_din,
            WRITEBACK_DOUT => writeback_dout
        );
end STRUCTURAL;